generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model DashboardMetric {
  key       String   @id
  label     String
  value     Int
  remark    String?
  updatedAt DateTime @updatedAt
}

model IssueCategoryStat {
  id       String @id
  category String
  value    Int
  sort     Int    @default(0)
}

model ManagedObject {
  id            String   @id
  name          String
  objectType    String
  objectSubtype String?
  parentName    String?
  status        String
  issueCount    Int      @default(0)
  reportCount   Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  issues   Issue[]
  reports  InspectionReport[]
  hotAreas MapHotArea[]
  taskPhotos TaskPhoto[]

  @@index([objectType])
  @@index([status])
}

model Issue {
  id        String   @id
  title     String
  category  String
  status    String
  severity  String
  foundAt   DateTime
  objectId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  object ManagedObject? @relation(fields: [objectId], references: [id])
  attachments IssueAttachment[]

  @@index([objectId])
  @@index([status])
  @@index([foundAt])
}

model IssueAttachment {
  id               String   @id
  issueId          String
  attachmentType   String
  fileName         String
  originalFileName String
  storagePath      String
  mimeType         String
  fileSize         Int
  remark           String?
  createdAt        DateTime @default(now())

  issue Issue @relation(fields: [issueId], references: [id])

  @@index([issueId])
  @@index([attachmentType])
  @@index([createdAt])
}

model InspectionReport {
  id                String   @id
  title             String
  reportDate        DateTime
  reportType        String
  relatedObjectId   String?
  relatedObjectName String
  issueCount        Int      @default(0)
  contentSummary    String?
  fileName          String?
  originalFileName  String?
  storagePath       String?
  mimeType          String?
  fileSize          Int?
  processStatus     String   @default("uploaded")
  taskId            String?  @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  relatedObject ManagedObject? @relation(fields: [relatedObjectId], references: [id])
  task          InspectionTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  photos        ReportPhoto[]

  @@index([relatedObjectId])
  @@index([reportType])
  @@index([reportDate])
  @@index([processStatus])
}

model MapAsset {
  id               String   @id
  name             String
  mapType          String
  sourceType       String
  fileName         String?
  originalFileName String?
  storagePath      String?
  mimeType         String?
  fileSize         Int?
  tilePath         String?
  tileMetadata     String?
  isActive         Boolean  @default(false)
  processStatus    String
  hotAreaCount     Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  hotAreas MapHotArea[]

  @@index([mapType])
  @@index([processStatus])
  @@index([isActive])
}

model MediaProcessingJob {
  id           String   @id
  jobType      String
  status       String   @default("queued")
  dedupeKey    String   @unique
  mediaId      String?
  inputJson    String
  outputJson   String?
  progress     Int      @default(0)
  errorMessage String?
  attempts     Int      @default(0)
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  media MediaAsset? @relation(fields: [mediaId], references: [id], onDelete: SetNull)

  @@index([jobType, status])
  @@index([mediaId])
  @@index([createdAt])
}

model MediaAsset {
  id               String   @id
  kind             String
  originalFileName String
  storagePath      String
  mimeType         String
  fileSize         Int
  parentMediaId    String?
  videoTimestampMs Int?
  createdAt        DateTime @default(now())

  parentMedia MediaAsset?  @relation("MediaAssetFrames", fields: [parentMediaId], references: [id], onDelete: Cascade)
  frames      MediaAsset[]  @relation("MediaAssetFrames")
  jobs        MediaProcessingJob[]
  inspectionTask InspectionTask? @relation("InspectionTaskSource")
  taskPhoto      TaskPhoto?      @relation("TaskPhotoMedia")

  @@unique([parentMediaId, videoTimestampMs])
  @@index([kind])
  @@index([createdAt])
}

model InspectionTask {
  id                String   @id
  name              String
  taskDate          DateTime
  sourceType        String
  inputType         String
  processStatus     String
  sourceMediaId     String?  @unique
  photoCount        Int      @default(0)
  pendingPhotoCount Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  sourceMedia MediaAsset?      @relation("InspectionTaskSource", fields: [sourceMediaId], references: [id], onDelete: SetNull)
  photos      TaskPhoto[]
  report      InspectionReport?

  @@index([taskDate])
  @@index([sourceType])
  @@index([processStatus])
  @@index([createdAt])
}

model TaskPhoto {
  id                 String   @id
  taskId             String
  mediaAssetId       String   @unique
  distributionStatus String   @default("pending")
  archiveObjectId    String?
  capturedAt         DateTime?
  videoTimestampMs   Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  task          InspectionTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  mediaAsset    MediaAsset      @relation("TaskPhotoMedia", fields: [mediaAssetId], references: [id], onDelete: Cascade)
  archiveObject ManagedObject?  @relation(fields: [archiveObjectId], references: [id], onDelete: SetNull)
  reportPhotos  ReportPhoto[]

  @@index([taskId, distributionStatus])
  @@index([distributionStatus, capturedAt(sort: Desc), videoTimestampMs, createdAt(sort: Desc), id], map: "task_photo_pending_feed_idx")
  @@index([taskId, videoTimestampMs, createdAt, id], map: "task_photo_task_order_idx")
  @@index([archiveObjectId])
  @@index([capturedAt])
}

model ReportPhoto {
  id          String   @id
  reportId    String
  taskPhotoId String
  sortIndex   Int
  createdAt   DateTime @default(now())

  report    InspectionReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  taskPhoto TaskPhoto        @relation(fields: [taskPhotoId], references: [id], onDelete: Cascade)

  @@unique([reportId, taskPhotoId])
  @@index([reportId, sortIndex])
  @@index([taskPhotoId])
}

model MapHotArea {
  id         String  @id
  label      String
  objectType String
  objectId   String?
  mapAssetId String
  x          Float?
  y          Float?
  width      Float?
  height     Float?
  polygon    String?
  color      String?

  mapAsset      MapAsset       @relation(fields: [mapAssetId], references: [id])
  managedObject ManagedObject? @relation(fields: [objectId], references: [id])

  @@index([mapAssetId])
  @@index([objectId])
}

model AuditLog {
  id         String   @id
  actor      String
  action     String
  targetType String
  targetId   String?
  summary    String
  createdAt  DateTime @default(now())

  @@index([action])
  @@index([targetType])
  @@index([createdAt])
}
