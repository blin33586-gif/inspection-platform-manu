{
  "name": "inspection-platform-manu",
  "version": "0.1.0",
  "private": true,
  "description": "巡检宝无人机巡检管理平台",
  "scripts": {
    "dev:admin": "pnpm --filter @xunjianbao/admin-web dev",
    "dev:api": "pnpm --filter @xunjianbao/api dev",
    "start:api": "NODE_ENV=production corepack pnpm --filter @xunjianbao/api start",
    "build": "pnpm -r build",
    "build:admin": "pnpm --filter @xunjianbao/admin-web build",
    "build:api": "pnpm --filter @xunjianbao/api build",
    "db:generate": "pnpm --filter @xunjianbao/api db:generate",
    "db:migrate": "pnpm --filter @xunjianbao/api db:migrate",
    "db:deploy": "pnpm --filter @xunjianbao/api db:deploy",
    "db:migrate-sqlite": "pnpm --filter @xunjianbao/api db:migrate-sqlite",
    "db:seed": "pnpm --filter @xunjianbao/api db:seed",
    "typecheck": "pnpm -r typecheck"
  },
  "packageManager": "pnpm@11.7.0",
  "devDependencies": {
    "@agent-tars/cli": "^0.3.0"
  }
}
